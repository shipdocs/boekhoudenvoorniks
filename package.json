{
  "name": "gratis-boekhouden",
  "version": "0.1.0",
  "description": "Gratis boekhouding voor zzp en mkb: offertes, facturen, bankimport en BTW-overzicht op een echte dubbele boekhouding.",
  "author": "Martin <info@shipdocs.app>",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "main": "dist/main/main/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "npm run build && npm run rebuild:electron && electron .",
    "dev": "npm run build:main && npm run rebuild:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run rebuild:node && vitest run",
    "test:watch": "vitest",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --linux --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "benchmark:ocr": "npm run build:main && node dist/main/tools/ocr-benchmark.js",
    "benchmark:maak": "npm run build:main && electron dist/main/tools/render-benchmark.js"
  },
  "build": {
    "appId": "app.shipdocs.gratisboekhouden",
    "productName": "Gratis Boekhouden",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "synopsis": "Gratis boekhouding voor zzp en vakmensen",
      "maintainer": "Martin <info@shipdocs.app>"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shipdocs",
        "repo": "gratis-boekhouden",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Gratis Boekhouden"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.1",
    "mt940-js": "^1.0.0",
    "nodemailer": "^10.0.10",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jsqr": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "homepage": "https://shipdocs.github.io/gratis-boekhouden/",
  "desktopName": "gratis-boekhouden.desktop"
}
