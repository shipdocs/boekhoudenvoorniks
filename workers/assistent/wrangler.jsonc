{
  // Assistent-Worker van BoekhoudenVoorNiks: online hulp bij categorievoorstellen (JEV), zie
  // docs/jev-assistent.md. Geen geheimen nodig: de app authenticeert met de lokale beheersleutel, die de
  // licentie-Worker controleert via de Service Binding LICENTIE.
  "$schema": "../licentie/node_modules/wrangler/config-schema.json",
  "name": "boekhoudenvoorniks-assistent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs en traces aan; de Worker logt zelf alleen status, versies en latency-bucket (geen inhoud)
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "routes": [{ "pattern": "assistent.boekhoudenvoorniks.nl", "custom_domain": true }],
  // ENABLED is de kill switch: alleen "true" = aan. GATEWAY_ID: AI Gateway met logs en cache UIT en
  // rate limiting AAN (instellen in het dashboard, zie docs). DAILY_QUOTA: aanroepen per administratie per dag.
  "vars": { "ENABLED": "false", "GATEWAY_ID": "boekhoudenvoorniks-assistent", "MODEL": "typesafe/jev", "DAILY_QUOTA": "200", "TIMEOUT_MS": "6000" },
  "ai": { "binding": "AI" },
  "services": [{ "binding": "LICENTIE", "service": "boekhoudenvoorniks-licentie", "entrypoint": "Controle" }],
  // PER_IP: 120 per minuut per IP-adres (ruim, ook voor een kantoor achter één adres), vóór de
  // licentie-controle; PER_ADMINISTRATIE: 30 per minuut per administratie + beheersleutel
  "ratelimits": [
    { "name": "PER_IP", "namespace_id": "1321", "simple": { "limit": 120, "period": 60 } },
    { "name": "PER_ADMINISTRATIE", "namespace_id": "1320", "simple": { "limit": 30, "period": 60 } }
  ]
}
