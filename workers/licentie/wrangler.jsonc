{
  // Licentie-Worker van BoekhoudenVoorNiks (zie README.md). Geheimen gaan via `wrangler secret put`,
  // nooit in dit bestand: MOLLIE_API_KEY, LICENSE_PRIVATE_KEY, PRICE_EUR.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boekhoudenvoorniks-licentie",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [{ "pattern": "licentie.boekhoudenvoorniks.nl", "custom_domain": true }],
  "vars": { "PUBLIC_URL": "https://licentie.boekhoudenvoorniks.nl" },
  "d1_databases": [
    // database_id na `npx wrangler d1 create boekhoudenvoorniks-licenties`
    { "binding": "LICENTIES", "database_name": "boekhoudenvoorniks-licenties", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ]
}
