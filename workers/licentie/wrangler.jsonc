{
  // Licentie-Worker van BoekhoudenVoorNiks (zie README.md). Geheimen gaan via `wrangler secret put`,
  // nooit in dit bestand: MOLLIE_API_KEY, LICENSE_PRIVATE_KEY.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boekhoudenvoorniks-licentie",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  // logs van de Worker zelf aan; de automatische regel per aanroep (URL, headers) uit
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "invocation_logs": false } },
  "routes": [{ "pattern": "licentie.boekhoudenvoorniks.nl", "custom_domain": true }],
  // MOLLIE_TESTMODE "false" = live (zelfde organisatie-toegangstoken); INVOICES "true" zodra het token
  // de rechten sales-invoices.read en sales-invoices.write heeft (factuur bij elke betaling); zie README
  // PRICE_EXCL_VAT: prijs per maand exclusief btw (afgeschreven: plus 21%); TRIAL_MONTHS: gratis maanden bij een eerste abonnement
  "vars": { "PRICE_EXCL_VAT": "9.00", "TRIAL_MONTHS": "4", "PUBLIC_URL": "https://licentie.boekhoudenvoorniks.nl", "MOLLIE_PROFILE_ID": "pfl_GTr2c9XX9n", "MOLLIE_TESTMODE": "false", "INVOICES": "true" },
  "d1_databases": [
    // aangemaakt met `npx wrangler d1 create boekhoudenvoorniks-licenties --location weur`
    { "binding": "LICENTIES", "database_name": "boekhoudenvoorniks-licenties", "database_id": "1ab9cdae-3eba-4788-aedb-c608b1e044aa", "migrations_dir": "migrations" }
  ],
  // /start maakt bij elke aanroep een klant en een betaling bij Mollie: 10 per minuut per IP-adres
  "ratelimits": [{ "name": "START_PER_IP", "namespace_id": "1330", "simple": { "limit": 10, "period": 60 } }]
}
