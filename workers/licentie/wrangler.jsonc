{
  // Licentie-Worker van BoekhoudenVoorNiks (zie README.md). Geheimen gaan via `wrangler secret put`,
  // nooit in dit bestand: MOLLIE_API_KEY, LICENSE_PRIVATE_KEY, PRICE_EUR.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boekhoudenvoorniks-licentie",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [{ "pattern": "licentie.boekhoudenvoorniks.nl", "custom_domain": true }],
  // MOLLIE_TESTMODE "false" = live (zelfde organisatie-toegangstoken); zie README
  "vars": { "PUBLIC_URL": "https://licentie.boekhoudenvoorniks.nl", "MOLLIE_PROFILE_ID": "pfl_GTr2c9XX9n", "MOLLIE_TESTMODE": "true" },
  "d1_databases": [
    // aangemaakt met `npx wrangler d1 create boekhoudenvoorniks-licenties --location weur`
    { "binding": "LICENTIES", "database_name": "boekhoudenvoorniks-licenties", "database_id": "1ab9cdae-3eba-4788-aedb-c608b1e044aa", "migrations_dir": "migrations" }
  ]
}
